{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "synthetic-example-sast",
          "rules": [
            {
              "id": "EXAMPLE-AUTH-1"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "EXAMPLE-AUTH-1",
          "level": "warning",
          "message": {
            "text": "Synthetic example: API authorization should be reviewed."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/modules/example/controller.ts"
                },
                "region": {
                  "startLine": 15
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
